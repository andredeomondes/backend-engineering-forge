{
  "name": "backend-engineering-forge",
  "version": "0.1.0",
  "private": true,
  "description": "A backend-first, project-driven learning system for mastering JavaScript, TypeScript, Node.js, NestJS, PostgreSQL, security, cloud and practical full-stack engineering.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:system": "node --test tools/forge-cli/lib/state.test.js tools/forge-cli/lib/commands/log.test.js tools/forge-core/*.test.js tools/forge-sql/*.test.js",
    "test:unit": "node tools/forge-core/run-unit-tests.js",
    "test:dsa": "node tools/forge-core/run-unit-tests.js dsa-01",
    "test:project-01": "node --test projects/01-order-workbench-cli/tests/order-workbench.test.js",
    "test:all": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tools/forge-web/tsconfig.json",
    "format": "prettier --write .",
    "forge": "node tools/forge-cli/forge.js",
    "forge:web": "node tools/forge-web/server.js",
    "project:01": "node projects/01-order-workbench-cli/src/cli.js",
    "sql:up": "docker compose -f exercises/04-sql-postgresql/compose.yaml up -d --wait",
    "sql:down": "docker compose -f exercises/04-sql-postgresql/compose.yaml down -v",
    "sql:test": "node tools/forge-sql/run-unit.js",
    "build:web": "vite build --config tools/forge-web/vite.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  }
}
